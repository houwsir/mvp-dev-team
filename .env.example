# ============================================================================
# MVP 开发专家团 · 环境变量示例
#
# 复制为 .env 后按需填写：cp .env.example .env
# 本文件里的变量全部可选——代码只读环境变量，不绑定任何厂商。
# ============================================================================

# ---- 模型接入（OpenAI 兼容协议即可）----
# 任意 OpenAI 兼容服务：OpenAI / DeepSeek / 通义 / Moonshot / 火山方舟 / vLLM / Ollama / one-api
MVP_API_KEY=
MVP_BASE_URL=https://api.openai.com/v1
MVP_MODEL=gpt-4o-mini

# 也可以只填标准的 OPENAI_* 变量，代码会按 MVP_* > OPENAI_* 的优先级回落
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# ---- 采样参数 ----
MVP_TEMPERATURE=0.3
MVP_MAX_TOKENS=8192
MVP_REQUEST_TIMEOUT=600

# ---- 按角色指定不同模型（可选，不填则统一用 MVP_MODEL）----
# 例如让架构师用强模型、工程师用便宜模型
# MVP_MODEL_DIRECTOR=
# MVP_MODEL_PM=
# MVP_MODEL_DESIGNER=
# MVP_MODEL_ARCHITECT=
# MVP_MODEL_FRONTEND=
# MVP_MODEL_BACKEND=
# MVP_MODEL_QA=
# MVP_MODEL_DEVOPS=

# ---- 工作流行为 ----
# 质量门最多驳回返工轮数
MVP_MAX_QA_ROUNDS=2
# 纯离线演练：不调用真实模型，只验证拓扑是否跑通
MVP_DRY_RUN=0
# 质量门前按产物 requirements.txt 安装依赖，让 pytest 有真实运行环境
MVP_INSTALL_DEPS=1
# 质量门里额外执行 npm install + npm run build（较慢，需要联网）
MVP_VERIFY_FRONTEND=0
