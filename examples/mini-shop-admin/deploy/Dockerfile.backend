# 后端镜像：FastAPI + Uvicorn + SQLite
# 构建上下文是仓库根目录（见 deploy/docker-compose.yml 的 context: ..）
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# 先装依赖，利用 Docker 层缓存：只改业务代码时不会重装依赖
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./

# SQLite 数据文件放在挂载卷里，容器重建不丢数据
ENV DATABASE_URL=sqlite:////data/mini-shop-admin.db
RUN mkdir -p /data

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=5 \
  CMD python -c "import json,urllib.request;r=urllib.request.urlopen('http://127.0.0.1:8000/api/health',timeout=2);assert r.status==200 and json.load(r).get('status')=='ok'"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
